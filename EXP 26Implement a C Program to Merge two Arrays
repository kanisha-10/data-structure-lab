#include <stdio.h>

int main() {
    int a[50], b[50], merged[100];
    int n1, n2, i, j;

    // Read first array
    printf("Enter size of first array: ");
    scanf("%d", &n1);
    printf("Enter elements of first array: ");
    for(i = 0; i < n1; i++)
        scanf("%d", &a[i]);

    // Read second array
    printf("Enter size of second array: ");
    scanf("%d", &n2);
    printf("Enter elements of second array: ");
    for(i = 0; i < n2; i++)
        scanf("%d", &b[i]);

    // Merge arrays
    for(i = 0; i < n1; i++)
        merged[i] = a[i];
    for(j = 0; j < n2; j++)
        merged[n1 + j] = b[j];

    // Print merged array
    printf("Merged Array: ");
    for(i = 0; i < n1 + n2; i++)
        printf("%d ", merged[i]);

    return 0;
}
