#include <stdio.h>

#define INF 9999
#define MAX 50

int main() {
    int cost[MAX][MAX], dist[MAX], visited[MAX];
    int n, src, i, j, min, u;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter cost matrix:\n");
    for(i = 0; i < n; i++)
        for(j = 0; j < n; j++)
            scanf("%d", &cost[i][j]);

    printf("Enter source vertex: ");
    scanf("%d", &src);

    for(i = 0; i < n; i++) {
        dist[i] = cost[src][i] ? cost[src][i] : INF;
        visited[i] = 0;
    }
    dist[src] = 0;

    for(i = 0; i < n; i++) {
        min = INF;
        for(j = 0; j < n; j++)
            if(!visited[j] && dist[j] < min) {
                min = dist[j];
                u = j;
            }

        visited[u] = 1;

        for(j = 0; j < n; j++)
            if(!visited[j] && dist[u] + cost[u][j] < dist[j] && cost[u][j] != 0)
                dist[j] = dist[u] + cost[u][j];
    }

    printf("Shortest path from %d:\n", src);
    for(i = 0; i < n; i++)
        printf("To %d = %d\n", i, dist[i]);

    return 0;
}
